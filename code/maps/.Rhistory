library(ggplot2)
library(ggrepel)
library(ggExtra)
library(gridExtra)
library(ggpubr)
library(ggridges)
library(tidyverse)
library(performance)
library(see)
library(GGally)
library(MASS)
library(forcats)
library(jtools) # for effect plots by predictor variable
sign.data <- read.csv("~/Github/PaleoSigns/results/features/signBase_features.csv")
View(sign.data)
nrow(sign.data)
# number of sign tokens
sum(sign.data$num.tokens)
# cave sites
table(sign.data$site_name)
# material
table(sign.data$material)
# object_type
table(sign.data$object_type)
sign.data$volume <- (sign.data$length_mm*sign.data$width_mm*sign.data$depth)/1000
sign.data$date <- as.numeric(substr(sign.data$date_bp_max, 1, 5))
sign.data$material <- fct_collapse(sign.data$material,
ivory = "ivory",
antler = "antler",
bone = "bone",
other_level = "other")
# object_type: collapse manually
sign.data$object_type <- fct_collapse(sign.data$object_type,
figurine_anthropomorph = c("figurine anthropomorph",
"plaque"),
# note: the "plaque" is the so-called Adorant with an anthropomorph figure on it.
figurine_zoomorph = c("figurine zoomorph"),
tool = c("awl", "perforated baton",
"rod/baton", "spatula/lissoir"),
tube_flute = c("flute", "tube", "tube/flute"),
personal_ornament = c("personal ornament"),
other_level = "other")
# number of sequences/objects after preprocessing
nrow(sign.data)
site.barplot <- ggplot(sign.data, aes(x = site_name, fill = site_name)) +
geom_bar() +
ylim(0, 200) +
geom_text(aes(label = after_stat(count)), stat = "count", vjust = -2.5, hjust = 0.5) +
geom_text(aes(label = paste(round(after_stat(prop)*100, 1), "%")),
stat = "prop", vjust = -1, hjust = 0.5) +
theme(legend.position = "none") +
theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust=1)) +
xlab("Cave Site")
#coord_flip()
#site.barplot
# barplot for object counts per material
material.barplot <- ggplot(sign.data, aes(x = material, fill = material)) +
geom_bar() +
ylim(0, 200) +
geom_text(aes(label = after_stat(count)), stat = "count", vjust = -2.5, hjust = 0.5) +
geom_text(aes(label = paste(round(after_stat(prop)*100, 1), "%")),
stat = "prop", vjust = -1, hjust = 0.5) +
theme(legend.position = "none") +
theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust=1)) +
xlab("Material")
#coord_flip()
#material.barplot
# barplot for object counts per object_type
type.barplot <- ggplot(sign.data, aes(x = object_type, fill = object_type)) +
geom_bar() +
ylim(0, 200) +
geom_text(aes(label = after_stat(count)), stat = "count", vjust = -2.5, hjust = 0.5) +
geom_text(aes(label = paste(round(after_stat(prop)*100, 1), "%")),
stat = "prop", vjust = -1, hjust = 0.5) +
theme(legend.position = "none") +
theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust=1)) +
xlab("Object-Type (Carrier)")
#coord_flip()
#type.barplot
combined.barplot <- ggarrange(site.barplot, type.barplot, material.barplot,
ncol = 3, nrow = 1,
labels = "AUTO")
combined.barplot
caveSigns.df <- data.frame(signs = character(0),
Freq = numeric(0),
site_name = character(0))
for (site_name in unique(sign.data$site_name)){
# get all cleaned codings per cave
codings <- sign.data[sign.data$site_name == site_name, ]$coding_clean
# collapse to one sequence
codings.collapsed <- paste(codings, collapse = "")
# remove underscores
codings.collapsed <- gsub("_", "", codings.collapsed)
# split into individual signs
signs <- unlist(strsplit(codings.collapsed, ""))
# get data frame with frequency counts
signs.df <- as.data.frame(table(signs))
# order by frequency
signs.df <- signs.df[order(-signs.df$Freq), ]
# add column with site_name
signs.df$site_name <- rep(site_name, nrow(signs.df))
# append results to dataframe
caveSigns.df <- rbind(caveSigns.df, signs.df)
}
caveSigns.barplot <- ggplot(caveSigns.df, aes(x = reorder(signs, Freq),
y = Freq, fill = signs)) +
#ylim(0, 700) +
geom_text(aes(label = signs), hjust = -1) +
geom_bar(stat = "identity") +
facet_wrap(~site_name, ncol = 5) +
theme(legend.position = "none") +
coord_flip() +
xlab("Sign Types") +
ylab("Token Frequency")
objectSigns.df <- data.frame(signs = character(0),
Freq = numeric(0),
object_type = character(0))
for (object_type in unique(sign.data$object_type)){
# get all cleaned codings per object type
codings <- sign.data[sign.data$object_type == object_type, ]$coding_clean
# collapse to one sequence
codings.collapsed <- paste(codings, collapse = "")
# remove underscores
codings.collapsed <- gsub("_", "", codings.collapsed)
# split into individual signs
signs <- unlist(strsplit(codings.collapsed, ""))
# get data frame with frequency counts
signs.df <- as.data.frame(table(signs))
# order by frequency
signs.df <- signs.df[order(-signs.df$Freq), ]
# add column with site_name
signs.df$object_type <- rep(object_type, nrow(signs.df))
# append results to dataframe
objectSigns.df <- rbind(objectSigns.df, signs.df)
}
objectSigns.barplot <- ggplot(objectSigns.df, aes(x = reorder(signs, Freq),
y = Freq, fill = signs)) +
#ylim(0, 500) +
geom_text(aes(label = signs), hjust = -1) +
geom_bar(stat = "identity") +
facet_wrap(~object_type, ncol = 6) +
theme(legend.position = "none") +
coord_flip() +
xlab("Sign Types") +
ylab("Token Frequency")
materialSigns.df <- data.frame(signs = character(0),
Freq = numeric(0),
material = character(0))
for (material in unique(sign.data$material)){
# get all cleaned codings per cave
codings <- sign.data[sign.data$material == material, ]$coding_clean
# collapse to one sequence
codings.collapsed <- paste(codings, collapse = "")
# remove underscores
codings.collapsed <- gsub("_", "", codings.collapsed)
# split into individual signs
signs <- unlist(strsplit(codings.collapsed, ""))
# get data frame with frequency counts
signs.df <- as.data.frame(table(signs))
# order by frequency
signs.df <- signs.df[order(-signs.df$Freq), ]
# add column with site_name
signs.df$material <- rep(material, nrow(signs.df))
# append results to dataframe
materialSigns.df <- rbind(materialSigns.df, signs.df)
}
materialSigns.barplot <- ggplot(materialSigns.df, aes(x = reorder(signs, Freq),
y = Freq, fill = signs)) +
#ylim(0, 700) +
geom_text(aes(label = signs), hjust = -1) +
geom_bar(stat = "identity") +
facet_wrap(~ material, ncol = 4) +
theme(legend.position = "none") +
coord_flip() +
xlab("Sign Types") +
ylab("Token Frequency")
signsCombined.barplot <- ggarrange(caveSigns.barplot, objectSigns.barplot, materialSigns.barplot,
nrow = 3,
labels = "AUTO")
signsCombined.barplot
feature.name <- "hrate.chars"
feature.values <- get(feature.name, sign.data)
objectType.plot <- ggplot(sign.data, aes(x = feature.values,
y = fct_reorder(object_type, feature.values),
fill = after_stat(x))) +
geom_density_ridges_gradient(scale = 1, color = "white",
quantile_lines = T, quantiles = 2) +
scale_fill_viridis_c(name = feature.name, option = "D") +
geom_point(shape = 124, alpha = 0.7, size = 3) +
xlab(paste("Feature Values ", "(", feature.name, ")", sep = "")) +
ylab("Object-Type (Carrier)") +
theme(legend.position = "none")
material.plot <- ggplot(sign.data, aes(x = feature.values,
y = fct_reorder(material, feature.values),
fill = after_stat(x))) +
geom_density_ridges_gradient(scale = 1, color = "white",
quantile_lines = T, quantiles = 2) +
scale_fill_viridis_c(name = feature.name, option = "D") +
geom_point(shape = 124, alpha = 0.7, size = 3) +
xlab(paste("Feature Values ", "(", feature.name, ")", sep = "")) +
ylab("Material") +
theme(legend.position = "none")
site.plot <- ggplot(sign.data, aes(x = feature.values,
y = fct_reorder(site_name, feature.values),
fill = after_stat(x))) +
geom_density_ridges_gradient(scale = 1, color = "white",
quantile_lines = T, quantiles = 2) +
scale_fill_viridis_c(name = feature.name, option = "D") +
geom_point(shape = 124, alpha = 0.7, size = 3) +
xlab(paste("Feature Values ", "(", feature.name, ")", sep = "")) +
ylab("Cave Site") +
theme(legend.position = "none")
preservation.plot <- ggplot(sign.data, aes(x = feature.values,
y = fct_reorder(preservation, feature.values),
fill = after_stat(x))) +
geom_density_ridges_gradient(scale = 1, color = "white",
quantile_lines = T, quantiles = 2) +
scale_fill_viridis_c(name = feature.name, option = "D") +
geom_point(shape = 124, alpha = 0.7, size = 3) +
xlab(paste("Feature Values ", "(", feature.name, ")", sep = "")) +
