objects <- read.csv("~/Github/PaleoSigns/data/signBase/Sb2Artifact-2025-03-06.csv")
nrow(objects)
# Select Aurignacian objects from Swabian Jura Caves
objects <- objects[objects$archaeological_unit == "Aurignacian", ]
objects <- objects[objects$site_name == "Vogelherd" |
objects$site_name == "Hohle Fels" |
objects$site_name == "Geissenklösterle" |
objects$site_name == "Hohlenstein-Stadel" |
objects$site_name == "Bockstein-Törle", ]
objects <- objects[objects$sign_coding != "", ] # remove objects with no sign coding
nrow(objects)
sites <- count(objects, site_name)
colnames(sites) <- c("site_name", "number_of_objects")
print(sites)
register_stadiamaps(key = "c56e7665-ab34-4608-8730-428e35d2766e", write = FALSE)
register_google(key = "AIzaSyAcUyL4fn9xytEjBaHLIC905Y_PPP5Wmdo")
