size = volume, color = volume)) +
geom_point(alpha = 0.5) +
scale_x_continuous(trans = "reverse") +
#geom_label_repel(aes(label = object_type)) +
geom_smooth(method = "lm") +
#geom_smooth(method = "loess", linetype = "dashed") +
ylab(paste("Feature Values ", "(", feature.name, ")", sep = "")) +
xlab("Date (BP, max)") +
theme(legend.position = "none")
token.plot <- ggplot(sign.data, aes(x = num.tokens, y = feature.values,
size = volume, color = volume)) +
geom_point(alpha = 0.5) +
#geom_label_repel(aes(label = object_type)) +
geom_smooth(method = "lm") +
geom_smooth(method = "loess", linetype = "dashed") +
ylab(paste("Feature Values ", "(", feature.name, ")", sep = "")) +
xlab("Number of Sign Tokens") +
theme(legend.position = "none")
type.plot <- ggplot(sign.data, aes(x = num.types, y = feature.values,
size = volume, color = volume)) +
geom_point(alpha = 0.5) +
#geom_label_repel(aes(label = object_type)) +
geom_smooth(method = "lm") +
geom_smooth(method = "loess", linetype = "dashed") +
ylab(paste("Feature Values ", "(", feature.name, ")", sep = "")) +
xlab("Number of Sign Types") +
theme(legend.position = "none")
predictor.plot <- ggarrange(objectType.plot, material.plot, site.plot,
preservation.plot, volume.plot, date.plot,
ncol = 3, nrow = 2,
labels = "AUTO")
predictor.plot
