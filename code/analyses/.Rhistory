geom_density_ridges_gradient(alpha = 0.5, quantile_lines = TRUE, quantiles = 2) +
scale_fill_viridis_c(name = "Accuracy", option = "C") +
geom_segment(aes(y = as.numeric(as.factor(comparison)), yend = as.numeric(as.factor(comparison)) +1, xend = baseline))
xlab("Accuracy") +
ylab("Comparison") +
theme(legend.position = "none")
