cave.barplot <- ggplot(sign.data, aes(x = site_name, fill = site_name)) +
geom_bar() +
ylim(0, 160) +
geom_text(aes(label = after_stat(count)), stat = "count", vjust = -1, hjust = -1) +
geom_text(aes(label = paste(round(after_stat(prop)*100, 1), "%")),
stat = "prop", vjust = 1, hjust = -0.2) +
theme(legend.position = "none") +
xlab("Cave Site") +
coord_flip()
cave.barplot
