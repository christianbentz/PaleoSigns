model5.summary <- summary(model5)
# get model information
df.model5 <- model5.summary$df[1]
res.df.model5 <- model5.summary$df[2]
f.statistic.model5 <- model5.summary$fstatistic[[1]]
p.value.model5 <- unname(pf(model5.summary$fstatistic[1L],
model5.summary$fstatistic[2L],
model5.summary$fstatistic[3L],
lower.tail = FALSE))
aic.model5 <- AIC(model5)
summary(model5)
model5 <- lm(feature.values ~ volume + date + object_type + as.factor(preservation), sign.data)
summary(model5)
model5 <- lm(feature.values ~ volume + date + as.factor(object_type) + preservation, sign.data)
summary(model5)
contrasts(sign.data$object_type)
baseline.model <- lm(feature.values ~ 1, sign.data)
summary(baseline.model)
mean(sign.data$hrate.chars)
