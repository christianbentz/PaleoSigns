id <- row.data$id
corpus <- row.data$corpus
subcorpus <- row.data$subcorpus
sequence <- as.character(row.data$sequence)
num.tokens <- nchar(as.character(row.data$sequence))
row.data
if (corpus == "Proto-Cuneiform"){
chars <- unlist(strsplit(sequence, " "))
} else {
