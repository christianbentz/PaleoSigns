knitr::opts_chunk$set(echo = TRUE)
library(ggplot2)
library(ggrepel)
library(ggExtra)
library(gridExtra)
library(ggpubr)
library(ggridges)
library(tidyverse)
library(performance)
library(see)
library(GGally)
library(MASS)
library(forcats)
sign.data <- read.csv("~/Github/UpperPalCombinatorics/results/features/signBase_features.csv")
# select Aurignacian data
sign.data <- sign.data[sign.data$archaeological_unit == "Aurignacien", ]
sign.data$volume <- (sign.data$length_mm*sign.data$width_mm*sign.data$depth)/1000
sign.data$date <- as.numeric(substr(sign.data$date_bp_max, 1, 5))
sign.data$material <- fct_collapse(sign.data$material,
ivory = "ivory",
antler = "antler",
bone = "bone",
other_level = "other")
# object_type: collapse manually
sign.data$object_type <- fct_collapse(sign.data$object_type,
figurine_anthropomorph = c("figurine anthropomorph",
"plaquette"),
# note: the "plaquette" is the so-called Adorant with an anthropomorph figure on it.
figurine_zoomorph = grep('figurine zoomorph.', unique(sign.data$object_type), value = TRUE),
tool = c("awl", "bâton percé",
"rod/bâton", "spatula/lissoir"),
tube_flute = c("flute", "tube", "tube/flute"),
personal_ornament = c("personal ornament"),
other_level = "other")
feature.name <- "hrate.chars"
feature.values <- get(feature.name, sign.data)
linear.model <- lm(feature.values ~ object_type + material + volume + date + preservation + site_name,
data = sign.data)
summary(linear.model)
AIC(linear.model)
check_model(linear.model)
effect_plot(linear.model, pred = object_type)
install.packages("jtools")
library(jtools)
effect_plot(linear.model, pred = object_type)
effect_plot(linear.model, pred = object_type, interval = TRUE, partial.residuals = TRUE,
jitter = .2)
effect_plot(linear.model, pred = object_type, interval = TRUE, partial.residuals = TRUE,
jitter = .2)
effect_plot(linear.model, pred = material, interval = TRUE, partial.residuals = TRUE,
jitter = .2)
effect_plot(linear.model, pred = volume, interval = TRUE, partial.residuals = TRUE,
jitter = .2)
effect_plot(linear.model, pred = preservation, interval = TRUE, partial.residuals = TRUE,
jitter = .2)
effect_plot(linear.model, pred = site_name, interval = TRUE, partial.residuals = TRUE,
jitter = .2)
effect_plot(linear.model, pred = date, interval = TRUE, partial.residuals = TRUE,
jitter = .2)
plot_summs(linear.model, plot.distributions = TRUE)
plot_summs(linear.model, plot.distributions = TRUE, inner_ci_level = .9)
linear.model.interaction <- lm(feature.values ~ object_type*volume + material + date + preservation + site_name,
data = sign.data)
plot_summs(linear.model, linear.model.interaction, plot.distributions = TRUE, inner_ci_level = .9)
install.packages("broom.mixed")
plot_summs(linear.model, linear.model.interaction, plot.distributions = TRUE, inner_ci_level = .9)
plot_summs(linear.model, linear.model.interaction, plot.distributions = TRUE)
linear.model <- lm(feature.values ~ object_type + material + volume + date + preservation + site_name,
data = sign.data)
AIC(linear.model)
AIC(linear.model.interaction)
linear.model <- lm(feature.values ~ object_type + material + volume + date + preservation + site_name,
data = sign.data)
AIC(linear.model)
# model with interaction between object_type and volume
linear.model.interaction <- lm(feature.values ~ object_type*volume + material + date + preservation + site_name,
data = sign.data)
AIC(linear.model.interaction)
summ(linear.model)
linear.model <- lm(feature.values ~ object_type + material + volume + date + preservation + site_name,
data = sign.data)
AIC(linear.model)
# model with interaction between object_type and volume
linear.model.interaction <- lm(feature.values ~ object_type*volume + material + date + preservation + site_name,
data = sign.data)
AIC(linear.model.interaction)
# model with interaction between object_type and volume
linear.model.interaction2 <- lm(feature.values ~ object_type + material + date + preservation*volume + site_name,
data = sign.data)
AIC(linear.model.interaction2)
plot_summs(linear.model, plot.distributions = TRUE)
plot_summs(linear.model, linear.model.interaction, plot.distributions = TRUE)
plot_summs(linear.model, plot.distributions = TRUE)
plot_summs(linear.model, plot.distributions = TRUE, coefs = c("object type: figurine anthropomorph" = object_typefigurine_anthropomorph))
plot_summs(linear.model, plot.distributions = TRUE, coefs = c("object type" = object_type))
plot_summs(linear.model, plot.distributions = TRUE, coefs = c("My pretty new name 1" = ugly_name_1, "My pretty new name 2" = ugly_name_2))
plot_summs(linear.model, plot.distributions = TRUE, coefs = c("My pretty new name 1" = object_typefigurine_anthropomorph, "My pretty new name 2" = ugly_name_2))
plot_summs(linear.model, plot.distributions = TRUE)
?plot_summs()
plot_coefs(linear.model, plot.distributions = TRUE)
plot_coefs(linear.model, plot.distributions = TRUE, coefs = c("object type: figurine anthropomorph" = object_typefigurine_anthropomorph))
plot_coefs(linear.model, plot.distributions = TRUE, coefs = c("object type: figurine anthropomorph" = "object_typefigurine_anthropomorph"))
plot_coefs(linear.model, plot.distributions = TRUE),
plot_coefs(linear.model, plot.distributions = TRUE,
coefs = c("Object type: figurine anthropomorph" = "object_typefigurine_anthropomorph",
"Object type: figurine zoomorph" = "object_typefigurine_zoomorph",
"Object type: tube or flute" = "object_typetube_flute",
"Object type: personal ornament" = "object_typepersonal_ornament",
"Material: bone" = "materialbone",
"Material: ivory" = "materialivory",
"Volume" = "volume",
"Age of object" = "date",
"Preservation: complete" = "preservationcomplete",
"Preservation: fragmented" = "preservationfragmented",
"Site name: Hohle Fels" = "site_nameHohle Fels",
"Site name: Vogelherd" = "site_nameVogelherd"))
