summary(pca)
variance = pca $sdev^2 / sum(pca $sdev^2)
# Scree plot
qplot(c(1:4), variance) +
geom_line() +
geom_point(size=4)+
xlab("Principal Component") +
ylab("Variance Explained") +
ggtitle("Scree Plot") +
ylim(0, 1)
qplot(c(1:4), variance) +
geom_line() +
geom_col() +
geom_point(size=4)+
xlab("Principal Component") +
ylab("Variance Explained") +
ggtitle("Scree Plot") +
ylim(0, 1)
