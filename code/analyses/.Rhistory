center = TRUE,
scale. = TRUE)
print(pca)
summary(pca)
variance = pca $sdev^2 / sum(pca $sdev^2)
PCs <- paste("PC", c(1:4), sep = "")
pca.df <- data.frame(PCs, variance)
# Scree plot
ggplot(pca.df, aes(x = PCs, y = variance)) +
geom_col(alpha = 0.5) +
geom_point(size = 4)+
xlab("Principal Component") +
ylab("Variance Explained") +
ggtitle("Scree Plot") +
ylim(0, 1)
biplot <- ggbiplot(pca,
obs.scale = 1,
var.scale = 1,
groups = estimations.df.selected$subcorpus,
ellipse = TRUE,
ellipse.alpha = 0.1,
circle = FALSE,
#ellipse.prob = 0.68, # NULL = 0.68
alpha = 0.3) +
theme(legend.position = 'top')
print(biplot)
biplot <- ggbiplot(pca,
obs.scale = 1,
var.scale = 1,
groups = estimations.df.selected$writing_system,
ellipse = TRUE,
ellipse.alpha = 0.1,
circle = FALSE,
#ellipse.prob = 0.68, # NULL = 0.68
alpha = 0.3) +
theme(legend.position = 'top')
print(biplot)
