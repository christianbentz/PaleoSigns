file.choose(9)
file.choose()
estimations.df <- read.csv("~Github/UpperPalCombinatorics/results/features_combined.csv")
estimations.df <- read.csv("~/Github/UpperPalCombinatorics/results/features_combined.csv")
estimations.df <- read.csv("~/Github/UpperPalCombinatorics/results/features_combined.csv")
head(estimations.df)
