library(stringr)
library(ggplot2)
library(ggrepel)
library(dplyr)
library(ggExtra)
library(ggpubr)
sign.data <- read.csv("~/Github/UpperPalCombinatorics/results/signBase_features.csv")
head(sign.data)
unique(sign.data$object_type)
sign.data <- read.csv("~/Github/UpperPalCombinatorics/results/signBase_features.csv")
# select columns
sign.data <- select(sign.data, c('object_id','techno_complex', 'site_name',
'longitude', 'latitude', 'material', 'object_type',
'num.char', 'huni.chars', 'hrate.chars', 'hrate.chars.random',
'ttr.chars', 'rm.chars'))
head(sign.data)
sign.data <- read.csv("~/Github/UpperPalCombinatorics/results/signBase_features.csv")
# select columns for direct comparison with NaLaFi sample
sign.data <- select(sign.data, c('techno_complex', 'num.char', 'huni.chars', 'hrate.chars',
'ttr.chars', 'rm.chars'))
# change column names
colnames(sign.data) <- c('subcorpus','num.char','huni.chars', 'hrate.chars',
'ttr.chars', 'rm.chars')
head(sign.data)
nalafi <- read.csv("~/Github/NaLaFi/results/features.csv")
# select columns
nalafi <- select(nalafi, c('subcorpus','num.char','huni.chars', 'hrate.chars', 'ttr.chars', 'rm.chars'))
# select only data with 100 chars
nalafi <- nalafi[nalafi$num.char == 100, ]
nalafi <- nalafi[nalafi$num.char == 100, ]
# combine the data frames
estimations.df <- rbind(sign.data, nalafi)
nrow(estimations.df)
View(estimations.df)
huni.hrate.chars.plot <- ggplot(estimations.df, aes(x = huni.chars, y = hrate.chars,
colour = subcorpus, fill = subcorpus)) +
geom_point(alpha = 0.3, size  = 1) +
labs(x = "Unigram entropy for characters", y = "Entropy rate for characters") #+
#theme(legend.position = c(.8,.2))
#facet_wrap(~subcorpus)
huni.hrate.chars.plot <- ggMarginal(huni.hrate.chars.plot, type = "histogram", colour = "white",
fill = "light grey")
huni.hrate.chars.plot
