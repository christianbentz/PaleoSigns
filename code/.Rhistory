proc.time <- end_time - start_time
print(proc.time)
write.csv(results.df, file = paste(c("~/Github/UpperPalCombinatorics/results/results_MLP_",
act.fct.name, "_",
err.fct, "_",
algorithm,
".csv"
), collapse = ""),
row.names = F)
